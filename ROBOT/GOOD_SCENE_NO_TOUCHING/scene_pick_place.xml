<mujoco model="so_arm100 pick_place_scene">
  <include file="so_arm100.xml"/>

  <option timestep="0.004" gravity="0 0 -9.81"/>

  <statistic center="0.12 -0.02 0.08" extent="0.55"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="55" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.30 0.52 0.73" rgb2="0.02 0.02 0.03" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.22 0.29 0.35" rgb2="0.12 0.17 0.21" markrgb="0.75 0.75 0.75" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="6 6" reflectance="0.15"/>
    <material name="cube_mat" rgba="0.82 0.23 0.16 1"/>
    <material name="goal_mat" rgba="0.15 0.82 0.36 0.70"/>
  </asset>

  <worldbody>
    <light pos="0.6 0.1 1.4" dir="-0.3 -0.1 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <!-- Table -->
      <body name="table" pos="0.4 0 0.1">
          <geom name="table_geom" type="box" size="0.25 0.25 0.1" pos="0 0 0" rgba="0.8 0.6 0.4 1"/>
      </body>

    <!-- Object to pick (on table center) -->
    <body name="object" pos="0.28 -0.15 0.22">
        <joint name="object_joint" type="free"/>
        <geom name="object_geom" type="box" size="0.02 0.02 0.02" rgba="0 1 0 1" mass="0.005" friction="2.0 0.005 0.0001"/>
    </body>

    <!-- Goal Placement (within ~0.2–0.3 m reach of robot base) -->
    <body name="r_goal" pos="-0.15 -0.4 0.075">
        <geom name="r_goal_geom" type="cylinder" size="0.07 0.075" rgba="0.5 0.25 0.25 1"/>
    </body>
    <body name="g_goal" pos="0.0 -0.4 0.075">
        <geom name="g_goal_geom" type="cylinder" size="0.07 0.075" rgba="0.25 0.5 0.25 1"/>
    </body>
    <body name="b_goal" pos="0.15 -0.4 0.075">
        <geom name="b_goal_geom" type="cylinder" size="0.07 0.075" rgba="0.25 0.25 0.5 1"/>
    </body>

    <camera name="track_cam" pos="0.55 -0.55 0.45" xyaxes="0.707 0.707 0 -0.34 0.34 0.88"/>
  </worldbody>

  <!-- 6 robot joints + 7 object free-joint (x y z qw qx qy qz) -->
  <keyframe>
    <key name="home"
         qpos="0 -1.57 1.57 1.57 -1.57 0  0.2 0 0.22 1 0 0 0"
         ctrl="0 0 0 0 0 0"/>
  </keyframe>
</mujoco>
